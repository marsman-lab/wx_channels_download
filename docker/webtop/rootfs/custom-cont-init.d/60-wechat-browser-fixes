#!/usr/bin/with-contenv bash
# local: 微信内嵌浏览器(WeChatAppEx)/Chromium 稳定性修复
# 三件套：
# 1) tun MTU：SunnyNet tun 默认 1500，加封装开销后满尺寸包被丢(页面空白/一直加载)，
#    实测 1200 零丢包。tun 由下载器启动时创建，故用常驻循环纠正(容器内 root 有 NET_ADMIN)。
# 2) 拒绝 QUIC(UDP 443)：QUIC 绕过 MITM 无法抓包，且在内嵌浏览器里表现为一直加载；
#    REJECT 让客户端快速回退 TCP。
# 3) chromium 默认浏览器直指真实二进制：包装脚本在 root 下丢 --no-sandbox 导致
#    "无法执行默认网络浏览器"。(非 root 下带 --no-sandbox 也无害)

setsid bash -c 'while :; do ip link set tun0 mtu 1200 2>/dev/null; sleep 2; done' \
    </dev/null >/dev/null 2>&1 &

iptables -A OUTPUT -p udp --dport 443 -j REJECT 2>/dev/null || true

sed -i 's|^Exec=.*|Exec=/usr/lib/chromium/chromium --no-sandbox --password-store=basic %U|' \
    /usr/share/applications/chromium.desktop 2>/dev/null || true
